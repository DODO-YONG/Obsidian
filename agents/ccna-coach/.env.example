# 형식만 공유. 실제 값은 볼트 루트 .env 에 (git 제외).
GOOGLE_API_KEY=
# 선택: 모델 고정 (비우면 자동 전환)
GEMINI_MODEL=
# 선택: 시험일 → 화면에 D-day (내 서버 연결 시에만 표시)
CCNA_EXAM_DATE=
# 선택: 넣으면 방문자에게 접속 코드를 요구 (비우면 누구나 사용)
CCNA_ACCESS_CODE=
# 선택: 방문자 1명당 시간당 / 방문자 전체 하루 AI 요청 한도 (기본 30 / 300)
CCNA_GUEST_PER_HOUR=
CCNA_DAILY_LIMIT=

# ── Vercel 환경변수 (새 TRACER: 값은 Vercel 대시보드에만. SETUP.md 참고) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=            (Publishable key, 공개돼도 되는 키)
# SUPABASE_SERVICE_ROLE_KEY=    (Secret key, 절대 공개 금지)
# TRACER_OWNER_EMAIL=           (주인 구글 메일 — 저장소에 쓰지 말 것)
# TRACER_NEW_USER_STATUS= / TRACER_GLOBAL_DAILY_AI= / TRACER_BANK_MIN= / TRACER_BANK_RATIO= / TRACER_REPORT_THRESHOLD=
# 기존 풀이 기록 옮기기(migrate_private_log.py)는 볼트 .env 의 SUPABASE_URL·SUPABASE_SERVICE_ROLE_KEY·TRACER_OWNER_EMAIL 을 읽음
