# macOS
.DS_Store

# Obsidian: 창 배치·최근 파일 (기기마다 다르고 자주 바뀜)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# Claude Code 개인 설정
.claude/settings.local.json

# ── 🔒 비밀·민감 정보 (절대 올리지 않음) ──────────────────
# API 키·토큰: 각 폴더의 .env 에 두고, 형식만 .env.example 로 공유
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
credentials*.json
secrets*.json
# 올리고 싶지 않은 문서·메모: 아무 곳에나 private/ 폴더를 만들어 넣으면 됨
private/
*.private.*

# ── 코드 부산물 (용량만 크고 다시 만들 수 있음) ──────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.log

# 점검 리포트: 대상 사이트의 취약점 정보 → 절대 공개 저장소에 올리지 않음
reports/

# Playwright 시험 실패 기록
test-results/

# 문제은행 원본은 비공개 저장소 Tracer-Route 에만(공개 저장소에 다시 올리지 않음)
agents/ccna-coach/bank/
